// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model Receipt {
  id            String        @id @default(uuid())
  userId String?
  user   User? @relation(fields: [userId], references: [id])
  store         String?
  branch        String?
  purchaseDate  String?
  purchaseTime  String?
  paymentMethod String?
  subtotal      Int?
  tax           Int?
  total         Int?
  rawJson       Json?
  fileName      String?  
  /// PROCESSED is a confirmed save. PENDING is the legacy default and stays valid.
  status       String  @default("EXTRACTING")
  errorMessage String?
  createdAt     DateTime      @default(now())
  filePath String?
  receiptType String?
  publicFileUrl String?
  items         ReceiptItem[]
  processingJob ProcessingJob?
  notifications Notification[]
}

model ReceiptItem {
  id          String   @id @default(uuid())
  receiptId   String
  sku         String?
  description String
  quantity    Float?
  unit        String?
  unitPrice   Int?
  totalPrice  Int?
  category    String?
  createdAt   DateTime @default(now())

  receipt     Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}
model User {
  id         String   @id // Clerk userId

  receipts       Receipt[]
  categories     Category[]
  processingJobs ProcessingJob[]
  notifications  Notification[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


model Category {
  id          String   @id @default(uuid())
  userId      String

  code        String
  displayName String?

  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, code])
}

model UserSettings {
  id         String   @id @default(uuid())
  userId     String   @unique

  language       String   @default("en")
  locale     String   @default("es-CL")
  dateFormat String   @default("dd-MM-yyyy")

  currencyLocale String @default("es-CL")
  currencyCode   String @default("CLP")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProcessingJob {
  id             String    @id @default(uuid())
  receiptId      String    @unique
  userId         String
  status         String    @default("QUEUED")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  lockedUntil    DateTime?
  lockedBy       String?
  lastError      String?
  idempotencyKey String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  receipt       Receipt        @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id])
  notifications Notification[]

  @@unique([userId, idempotencyKey])
  @@index([status, availableAt])
  @@index([lockedUntil])
  @@index([userId])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  type       String
  receiptId  String?
  jobId      String
  messageKey String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user    User          @relation(fields: [userId], references: [id])
  receipt Receipt?      @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  job     ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, type])
  @@index([userId, readAt, createdAt])
}